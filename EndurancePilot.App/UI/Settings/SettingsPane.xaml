<UserControl x:Class="EndurancePilot.App.SettingsPane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="{DynamicResource PilotBackground}" Foreground="{DynamicResource PilotText}" FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True">
  <Grid Background="{DynamicResource PilotBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="24,18,28,10">
      <ui:Button x:Name="BackButton" Appearance="Transparent" Width="36" Height="36" Padding="0" Click="BackClicked" ToolTip="Back" AutomationProperties.Name="Back to Pilot">
        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="20" />
      </ui:Button>
      <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
    </StackPanel>
    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,16,28,24">
        <TextBlock Text="UPDATES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,0,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1" Margin="0,0,0,24">
          <StackPanel Margin="18">
            <TextBlock x:Name="InstalledVersionText" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="UpdateStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource PilotSecondary}" AutomationProperties.LiveSetting="Polite" />
            <ui:Button x:Name="CheckUpdatesButton" Content="Check for updates" HorizontalAlignment="Stretch" Click="CheckUpdatesClicked" />
            <ui:Button x:Name="DownloadUpdateButton" Content="Download update" HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="Collapsed" Click="DownloadUpdateClicked" />
          </StackPanel>
        </Border>
        <TextBlock Text="DISCORD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,0,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1" Margin="0,0,0,24">
          <StackPanel Margin="18">
            <TextBlock Text="Discord connection" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Pair this PC, check your connection or unlink Discord." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,14" />
            <ui:Button Content="Manage Discord pairing" HorizontalAlignment="Stretch" Click="DiscordClicked" />
          </StackPanel>
        </Border>
        <TextBlock Text="BACKGROUND" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,0,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1" Margin="0,0,0,24">
          <StackPanel Margin="18">
            <ui:ToggleSwitch x:Name="CloseToTrayToggle" Content="Keep running when closed" AutomationProperties.Name="Keep running when closed" />
            <TextBlock Text="Close hides Pilot in the tray. Turn off to quit instead; quitting stops the runner and Discord commands." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,18" />
            <ui:ToggleSwitch x:Name="StartupToggle" Content="Start with Windows" AutomationProperties.Name="Start with Windows" />
            <TextBlock Text="Open quietly in the tray when you sign in. The runner stays stopped until you start it." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,0,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1">
          <Grid Margin="18,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Manual theme" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Use the theme button to switch light and dark. Turn off to follow Windows." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="ManualThemeToggle" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Manual theme" />
          </Grid>
        </Border>
        <TextBlock Text="RUN OPTIONS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,24,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1">
          <StackPanel x:Name="RunOptions">
            <Grid Margin="18,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="End run when target reached" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Leave after completing the target wave. Turn off to keep playing until the mission ends." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="EndAtTargetToggle" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="End run when target reached" />
            </Grid>
            <Border Height="1" Background="{DynamicResource PilotBorder}" Margin="18,0" />
            <Grid Margin="18,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Wait for assistance" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Use the game's Wait for Assistance option when starting Endurance. Turn off for a solo start." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="AssistanceToggle" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Wait for assistance" />
            </Grid>
            <Border Height="1" Background="{DynamicResource PilotBorder}" Margin="18,0" />
            <Grid Margin="18,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="148" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Target wave" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ui:NumberBox x:Name="TargetWaveInput" Grid.Column="1" MinWidth="148" Height="40" Padding="10,6" FontSize="16" VerticalContentAlignment="Center" Value="30" Minimum="1" Maximum="30" MaxDecimalPlaces="0" AcceptsExpression="False" AutomationProperties.Name="Target wave" />
              <TextBlock x:Name="TargetWaveHint" Grid.Row="1" Grid.ColumnSpan="2" Text="30 waits for the final result. Lower targets leave when the next wave starts." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,10,0,0" />
            </Grid>
            <Border Height="1" Background="{DynamicResource PilotBorder}" Margin="18,0" />
            <Grid Margin="18,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Indefinite" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Repeat until you stop. Turn off to choose an attempt count on the main screen." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="IndefiniteToggle" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Run indefinitely" />
            </Grid>
            <Border Height="1" Background="{DynamicResource PilotBorder}" Margin="18,0" />
            <Grid Margin="18,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Launch and restart Fortnite" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Open Fortnite if it is closed and relaunch after a crash." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="LaunchToggle" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Launch and restart Fortnite" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="FOCUS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,24,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1" Padding="18">
          <StackPanel>
            <TextBlock Text="Keep Fortnite in the foreground" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="While the runner is active, Pilot restores and focuses Fortnite automatically before acting. Stop the runner to use other windows freely." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
            <ui:ToggleSwitch x:Name="FocusWhenIdleToggle" Visibility="Collapsed" />
            <ui:NumberBox x:Name="FocusIdleSecondsInput" Visibility="Collapsed" Minimum="2" Maximum="600" />
          </StackPanel>
        </Border>
        <TextBlock Text="SHORTCUT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,24,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1">
          <StackPanel Margin="18">
            <TextBlock Text="Start or stop runner" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Choose a global shortcut. The current one stays active if your choice is unavailable." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,12" />
            <ComboBox x:Name="HotkeyChoice" Height="38" AutomationProperties.Name="Start or stop shortcut" />
          </StackPanel>
        </Border>
        <TextBlock Text="DISCORD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" Margin="0,24,0,12" />
        <Border CornerRadius="12" Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1">
          <StackPanel Margin="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ui:ToggleSwitch x:Name="WebhookToggle" Grid.Column="1" AutomationProperties.Name="Discord notifications" />
            </Grid>
            <TextBlock Text="Webhook URL" FontSize="12" Margin="0,16,0,6" />
            <ui:TextBox x:Name="WebhookUrlInput" Height="38" Padding="8,6" FontSize="14" Margin="0,0,0,12" VerticalContentAlignment="Center" AutomationProperties.Name="Discord webhook URL" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <ui:Button Content="Save URL" HorizontalAlignment="Stretch" Click="SaveWebhookClicked" />
              <ui:Button x:Name="TestWebhookButton" Grid.Column="2" Content="Test all embeds" HorizontalAlignment="Stretch" Click="TestWebhookClicked" ToolTip="Sends 13 labelled samples, including mission rewards. Earnings are unchanged." AutomationProperties.Name="Test all embeds" />
            </Grid>
            <TextBlock x:Name="WebhookResult" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PilotSecondary}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="WebhookDeliveryStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource PilotSecondary}" Margin="0,6,0,0" />
            <Border Height="1" Background="{DynamicResource PilotBorder}" Margin="0,18,0,4" />
            <StackPanel x:Name="WebhookEventsPanel" />
            <Grid Margin="0,12,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Wave notification frequency" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ui:NumberBox x:Name="WaveFrequencyInput" Grid.Column="1" MinWidth="148" Height="40" Padding="10,6" FontSize="16" VerticalContentAlignment="Center" Value="5" Minimum="1" Maximum="30" MaxDecimalPlaces="0" AcceptsExpression="False" AutomationProperties.Name="Wave notification frequency" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PilotBorder}" Padding="28,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SaveStatus" Text="Changes save automatically." FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource PilotSecondary}" AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
