<UserControl x:Class="EndurancePilot.App.RewardPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource PilotSurface}" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
    <StackPanel>
      <TextBlock x:Name="PanelTitle" Text="Mission rewards" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PilotText}" />
      <StackPanel Margin="0,12,0,0">
        <ItemsControl x:Name="RewardItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource PilotBorder}" VerticalAlignment="Center">
                  <Grid>
                    <TextBlock Text="{Binding Fallback}" FontSize="16" Foreground="{DynamicResource PilotAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="2" />
                  </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource PilotText}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding QuantityLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PilotText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="RewardStatus" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource PilotSecondary}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>