<Window x:Class="EndurancePilot.App.DiscordRemoteDialog" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Discord · Endurance Pilot" Width="540" Height="820" MinWidth="460" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource PilotBackground}"
 Foreground="{DynamicResource PilotText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
 UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PilotSecondary}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,6,0,14" /><Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="{DynamicResource PilotSurface}" /><Setter Property="Foreground" Value="{DynamicResource PilotText}" /><Setter Property="BorderBrush" Value="{DynamicResource PilotBorder}" /></Style>
 </Window.Resources>
 <Grid Background="{DynamicResource PilotBackground}">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource PilotBorder}" BorderThickness="0,0,0,1" Padding="28,24,28,20">
   <StackPanel>
    <TextBlock Text="DISCORD CONNECTION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PilotSecondary}" />
    <TextBlock x:Name="Heading" Text="Your Pilot, from anywhere." FontSize="26" FontWeight="SemiBold" Margin="0,6,0,6" />
    <TextBlock x:Name="Intro" Text="Pair this PC to check your run and control Pilot from Discord." Style="{StaticResource Caption}" />
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="28,22,28,24">
    <StackPanel x:Name="Setup">
     <TextBlock Text="1. Get your pairing code" FontWeight="SemiBold" FontSize="15" />
     <TextBlock Text="Run /pilot pair in Discord. Copy the two values from the private message below." Style="{StaticResource Caption}" Margin="0,6,0,20" />
     <TextBlock Text="2. Connect this PC" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14" />
     <TextBlock Text="Discord user ID" /><TextBox x:Name="UserId" AutomationProperties.Name="Discord user ID" MaxLength="20" />
     <TextBlock Text="One-time pairing code" />
     <PasswordBox x:Name="PairingCode" AutomationProperties.Name="One-time pairing code" MaxLength="32" Padding="10,8" Margin="0,6,0,6" Background="{DynamicResource PilotSurface}" Foreground="{DynamicResource PilotText}" BorderBrush="{DynamicResource PilotBorder}" />
     <TextBlock Text="Valid for five minutes. Only enter it on your own PC." Style="{StaticResource Caption}" Margin="0,0,0,20" />
    </StackPanel>
    <Border x:Name="ConnectionCard" Background="{DynamicResource PilotSurface}" CornerRadius="12" Padding="18" Margin="0,0,0,20" Visibility="Collapsed">
     <StackPanel><TextBlock x:Name="ConnectionTitle" Text="Connected to Discord" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="ConnectionDetail" Style="{StaticResource Caption}" Margin="0,6,0,0" /></StackPanel>
    </Border>
    <TextBlock Text="What Discord can do" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Text="Progress, statistics and saved account names are available when requested." Style="{StaticResource Caption}" Margin="0,6,0,14" />
    <Border BorderBrush="{DynamicResource PilotBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
     <StackPanel>
      <CheckBox x:Name="AllowControl" Content="Game and account controls" FontWeight="SemiBold" />
      <TextBlock Text="Start or stop runs, launch Fortnite, switch accounts and sign in." Style="{StaticResource Caption}" Margin="26,4,0,16" />
      <CheckBox x:Name="AllowScreenshots" Content="Fortnite screenshots" FontWeight="SemiBold" />
      <TextBlock Text="Capture the game window. Player names and chat may be visible." Style="{StaticResource Caption}" Margin="26,4,0,0" />
     </StackPanel>
    </Border>
    <TextBlock x:Name="PermissionHint" Text="Optional permissions stay off until you choose them." Style="{StaticResource Caption}" Margin="0,10,0,16" />
    <Expander x:Name="Advanced" Header="Use your own Discord application" Margin="0,0,0,16">
     <StackPanel Margin="0,12,0,0">
      <TextBlock Text="Only use a service you trust. Its operator and Discord can see replies and requested screenshots." Style="{StaticResource Caption}" Margin="0,0,0,12" />
      <TextBlock Text="Worker address" /><TextBox x:Name="Origin" AutomationProperties.Name="Worker address" />
      <TextBlock Text="Discord application ID" /><TextBox x:Name="ApplicationId" AutomationProperties.Name="Discord application ID" />
      <TextBlock Text="Public verification key" /><TextBox x:Name="PublicKey" AutomationProperties.Name="Discord public verification key" />
      <ui:Button x:Name="ResetService" Content="Use official service" Click="ResetServiceClicked" />
     </StackPanel>
    </Expander>
    <Expander Header="Connection details" Margin="0,20,0,0">
     <StackPanel Margin="0,10,0,0"><TextBlock x:Name="TransportStatus" Style="{StaticResource Caption}" /><TextBlock x:Name="LastCommand" Style="{StaticResource Caption}" Margin="0,8,0,0" /></StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{DynamicResource PilotBorder}" BorderThickness="0,1,0,0" Padding="28,16">
   <StackPanel>
    <TextBlock Text="Discord and the service operator can see replies and requested screenshots. Never share your pairing code." Style="{StaticResource Caption}" Margin="0,0,0,12" />
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource PilotWarning}" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    <Grid><ui:Button x:Name="PairButton" Content="Pair this PC" Appearance="Primary" Background="{DynamicResource PilotAccent}" Foreground="{DynamicResource PilotOnAccent}" MouseOverBackground="{DynamicResource PilotAccentHover}" HorizontalAlignment="Stretch" Height="40" Click="PairClicked" />
     <ui:Button x:Name="DisconnectButton" Content="Disconnect this PC" HorizontalAlignment="Left" Height="40" Click="DisconnectClicked" Visibility="Collapsed" />
     <ui:Button x:Name="DoneButton" Content="Done" HorizontalAlignment="Right" Height="40" Click="DoneClicked" Visibility="Collapsed" />
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>

