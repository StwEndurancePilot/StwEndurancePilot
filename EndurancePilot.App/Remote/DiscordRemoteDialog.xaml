<Window x:Class="EndurancePilot.App.DiscordRemoteDialog" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Connect Discord" Width="420" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource PilotBackground}"
 Foreground="{DynamicResource PilotText}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
 UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PilotSecondary}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /></Style>
 </Window.Resources>
 <Border Background="{DynamicResource PilotBackground}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28">
   <TextBlock x:Name="Heading" Text="Connect Discord" FontSize="24" FontWeight="SemiBold" />
   <TextBlock x:Name="Intro" Text="Run /pair in Discord, then paste your details." Style="{StaticResource Caption}" Margin="0,6,0,24" />
   <StackPanel x:Name="Setup">
    <TextBlock Text="Discord ID" Margin="0,0,0,6" />
    <TextBox x:Name="UserId" AutomationProperties.Name="Discord ID" MaxLength="20" Padding="11,9" Margin="0,0,0,18" Background="{DynamicResource PilotSurface}" Foreground="{DynamicResource PilotText}" BorderBrush="{DynamicResource PilotBorder}" />
    <TextBlock Text="Pairing code" Margin="0,0,0,6" />
    <PasswordBox x:Name="PairingCode" AutomationProperties.Name="Pairing code" MaxLength="32" Padding="11,9" Margin="0,0,0,24" Background="{DynamicResource PilotSurface}" Foreground="{DynamicResource PilotText}" BorderBrush="{DynamicResource PilotBorder}" />
   </StackPanel>
   <Border x:Name="ConnectionCard" Background="{DynamicResource PilotSurface}" CornerRadius="10" Padding="16" Margin="0,0,0,24" Visibility="Collapsed">
    <StackPanel><TextBlock x:Name="ConnectionTitle" Text="Connected" FontWeight="SemiBold" /><TextBlock x:Name="ConnectionDetail" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
   </Border>
   <TextBlock x:Name="Feedback" Foreground="{DynamicResource PilotWarning}" Margin="0,0,0,16" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
   <ui:Button x:Name="PairButton" Content="Pair this PC" IsDefault="True" Appearance="Primary" Background="{DynamicResource PilotAccent}" Foreground="{DynamicResource PilotOnAccent}" MouseOverBackground="{DynamicResource PilotAccentHover}" HorizontalAlignment="Stretch" Height="42" Click="PairClicked" />
   <TextBlock x:Name="PairingNote" Text="Pairing enables game controls and screenshots through your Discord account." Style="{StaticResource Caption}" Margin="0,12,0,0" />
   <Grid>
    <ui:Button x:Name="DisconnectButton" Content="Disconnect" HorizontalAlignment="Left" Height="38" Click="DisconnectClicked" Visibility="Collapsed" />
    <ui:Button x:Name="DoneButton" Content="Done" HorizontalAlignment="Right" Height="38" Click="DoneClicked" Visibility="Collapsed" />
   </Grid>
  </StackPanel>
 </ScrollViewer>
 </Border>
</Window>
